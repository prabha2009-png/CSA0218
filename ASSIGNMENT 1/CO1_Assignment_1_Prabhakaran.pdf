BT 1 0 0 1 6 145.8 Tm /F3 7.2 Tf 9 TL (#include <stdio.h>) Tj T* (#include <limits.h>) Tj T* (typedef unsigned short meter_t;) Tj T*  T* (unsigned int consumption\(meter_t previous, meter_t current\)) Tj T* ({) Tj T* (    return \(unsigned int\)\(\(meter_t\)\(current - previous\)\);) Tj T* (}) Tj T*  T* (int main\(void\)) Tj T* ({) Tj T* (    printf\("sizeof\(meter_t\) = %zu bytes, maximum reading = %u\\\\n",) Tj T* (           sizeof\(meter_t\), \(unsigned\)USHRT_MAX\);) Tj T* (    printf\("Consumption: %u units\\\\n", consumption\(1200, 1530\)\);) Tj T* (    printf\("Consumption: %u units\\\\n", consumption\(65400, 120\)\);) Tj T* (    return 0;) Tj T* (}) Tj T* ET
