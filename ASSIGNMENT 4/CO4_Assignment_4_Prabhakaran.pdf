%PreformattedPara
0 0 0 rg
BT 1 0 0 1 7 171.4 Tm /F3 7.1 Tf 8.5 TL (#include <stdio.h>) Tj T* (#include <string.h>) Tj T*  T* (typedef struct { int day, month, year; } Date;) Tj T* (typedef struct { int systolic, diastolic; } BloodPressure;) Tj T* (typedef struct {) Tj T* (    char name[50];) Tj T* (    int age;) Tj T* (    char phone[16];) Tj T* (    BloodPressure bp;) Tj T* (    Date visitDate;) Tj T* (} Patient;) Tj T*  T* (#define MAX_PATIENTS 100) Tj T*  T* (int addPatient\(Patient *p, const Patient *newPatient, int *count\) {) Tj T* (    if \(*count >= MAX_PATIENTS\) return 0;) Tj T* (    p[*count] = *newPatient;) Tj T* (    ++\(*count\);) Tj T* (    return 1;) Tj T* (}) Tj T* ET
