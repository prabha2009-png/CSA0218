BT 1 0 0 1 7 196.9 Tm /F3 7.1 Tf 8.5 TL (#include <stdio.h>) Tj T* (enum kind { TEMPERATURE, HUMIDITY, STATUS };) Tj T* (struct reading {) Tj T* (    enum kind type;) Tj T* (    union { float celsius; int percent; char status[8]; } value;) Tj T* (};) Tj T* (void show\(const struct reading *r\) {) Tj T* (    switch \(r->type\) {) Tj T* (        case TEMPERATURE: printf\("Temp %.1f C\\n", r->value.celsius\); break;) Tj T* (        case HUMIDITY:   printf\("Humidity %d %%\\n", r->value.percent\); break;) Tj T* (        case STATUS:     printf\("Status %s\\n", r->value.status\); break;) Tj T* (    }) Tj T* (}) Tj T* (int main\(void\) {) Tj T* (    struct reading log[3] = {) Tj T* (        {TEMPERATURE, {.celsius = 31.5f}},) Tj T* (        {HUMIDITY, {.percent = 68}},) Tj T* (        {STATUS, {.status = "OK"}}) Tj T* (    };) Tj T* (    printf\("sizeof union = %zu, sizeof struct reading = %zu\\n",) Tj T* (           sizeof log[0].value, sizeof log[0]\);) Tj T* (    for \(int i = 0; i < 3; ++i\) show\(&log[i]\);) Tj T* (    return 0;) Tj T* (}) Tj T* ET
