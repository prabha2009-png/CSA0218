BT 1 0 0 1 7 247.9 Tm /F3 7.1 Tf 8.5 TL (#include <stdio.h>) Tj T* (struct date { int day, month, year; };) Tj T* (struct address { char city[20]; int pincode; };) Tj T* (struct parcel { int id; float weight; struct address to; struct date booked; };) Tj T*  T* (void print_parcel\(const struct parcel *p\) {) Tj T* (    printf\("%d %.1f kg %s-%d %02d/%02d/%04d\\n",) Tj T* (           p->id, p->weight, p->to.city, p->to.pincode,) Tj T* (           p->booked.day, p->booked.month, p->booked.year\);) Tj T* (}) Tj T* (void sort_by_weight\(struct parcel p[], int n\) {) Tj T* (    for \(int i = 0; i < n - 1; ++i\) {) Tj T* (        int min = i;) Tj T* (        for \(int j = i + 1; j < n; ++j\)) Tj T* (            if \(p[j].weight < p[min].weight\) min = j;) Tj T* (        if \(min != i\) {) Tj T* (            struct parcel temp = p[i];) Tj T* (            p[i] = p[min];) Tj T* (            p[min] = temp;) Tj T* (        }) Tj T* (    }) Tj T* (}) Tj T* (int main\(void\) {) Tj T* (    struct parcel list[3] = {) Tj T* (        {501, 4.5f, {"Madurai", 625001}, {12, 10, 2026}},) Tj T* (        {502, 1.2f, {"Chennai", 600077}, {12, 10, 2026}},) Tj T* (        {503, 2.8f, {"Coimbatore", 641001}, {13, 10, 2026}}) Tj T* (    };) Tj T* (    sort_by_weight\(list, 3\);) Tj T* (    for \(int i = 0; i < 3; ++i\) print_parcel\(&list[i]\);) Tj T* ET
Q
 

